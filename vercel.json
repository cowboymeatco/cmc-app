{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/register-sync",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/register-sync?phase=sweep",
      "schedule": "20 11 * * *"
    },
    {
      "path": "/api/cron/ringup-payments",
      "schedule": "*/30 14-23,0,1 * * *"
    },
    {
      "path": "/api/cron/ringup-payments?day=yesterday",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/exec/labor",
      "schedule": "0 12 * * 4"
    },
    {
      "path": "/api/cron/cleaning-close",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/cleaning-close",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/register-report",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/register-report",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/invoice-ready",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/invoice-ready",
      "schedule": "0 0 * * *"
    }
  ]
}

# Copy to .env next to reader.py and fill in.

# The Keyspan's port. Find it with:  python reader.py --ports
SCALE_PORT=COM3

# The indicator's serial port speed. 9600 is the Rice Lake default; the port
# must also be 8 data bits, no parity, 1 stop bit, and set to STREAM.
SCALE_BAUD=9600

# Which scale this reads. live_animal is the Rice Lake at harvest.
SCALE_ID=live_animal
KIOSK_NAME=kiosk-scale-reader

# The app, and the same token as SCALE_WEDGE_TOKEN in Vercel.
CMC_API_URL=https://app.cowboymeats.com
CMC_WEDGE_TOKEN=paste-the-token-here

# How often a changing weight is reported, and how often a still one is
# re-reported so the app knows the reader is alive.
POST_SECONDS=0.5
IDLE_SECONDS=5
